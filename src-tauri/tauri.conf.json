{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Limits",
  "version": "0.5.1",
  "identifier": "com.ai-limits.desktop",
  "build": {
    "beforeDevCommand": "sh scripts/tauri-dev-server.sh",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "AI Limits",
        "width": 900,
        "height": 600,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; media-src 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/md2it/ai-limits/main/updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3QzkyN0QzMjExNEM0NQpSV1JGVEJFeWZaSjhDcCtFd0F4TDloTzlsSnhvb29ZcEFtekQvZW9wdnNpUjZ3bEZQVlpTRVZRZwo="
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
